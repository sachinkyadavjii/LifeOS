{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeos-push",
  "main": "worker.js",
  "account_id": "d1edc26254aa49ff9c2cd8f9194d9a80",
  "workers_dev": true,
  "compatibility_date": "2026-10-24",
  "vars": {
    "APP_ORIGIN": "https://sachinkyadavjii.github.io",
    "VAPID_SUBJECT": "https://github.com/sachinkyadavjii/LifeOS"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeos-push",
      "database_id": "33591e48-3e8c-4030-93d9-c8b40893401c"
    }
  ]
}